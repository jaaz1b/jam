{
  "name": "octave-desktop",
  "productName": "Jam",
  "version": "3.2.0",
  "description": "Jam",
  "main": "src/main.js",
  "author": "Jam",
  "homepage": "https://github.com/jaaz1b/jam",
  "desktopName": "jam.desktop",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.octavestreaming.desktop",
    "productName": "Jam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon-small.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Jam-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jam",
      "artifactName": "Jam-Setup-${version}.${ext}",
      "uninstallDisplayName": "Jam"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "AudioVideo;Audio;Player",
      "executableName": "jam",
      "artifactName": "Jam-${version}-linux-x64.${ext}",
      "synopsis": "Music terminal with Discord presence",
      "description": "Octave, Monochrome, Spotify, Apple Music and YouTube Music in one window, with your song on your Discord profile.",
      "maintainer": "Jam",
      "vendor": "Jam",
      "desktop": {
        "entry": {
          "Name": "Jam",
          "GenericName": "Music player",
          "StartupWMClass": "Jam",
          "Keywords": "music;youtube;spotify;discord;"
        }
      },
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "build/icons",
          "to": "icons"
        }
      ]
    },
    "publish": null,
    "electronVersion": "45.2.1",
    "electronDist": "../.ecs/win",
    "extraResources": [
      {
        "from": "build/drm-setup.ps1",
        "to": "drm-setup.ps1"
      },
      {
        "from": "../ytm-dist",
        "to": "ytm"
      }
    ],
    "pacman": {
      "artifactName": "jam-${version}-x86_64.pacman",
      "packageName": "jam",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libdrm",
        "mesa",
        "at-spi2-core",
        "libcups",
        "libsecret",
        "xdg-utils",
        "mpv",
        "webkit2gtk-4.1",
        "libsoup3",
        "openssl",
        "dbus"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
