{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Jam for Android: the desktop set minus the desktop-only plugins (updater, global shortcuts).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "process:default",
    "core:window:allow-show",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text"
  ]
}
